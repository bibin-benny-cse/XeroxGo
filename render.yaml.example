services:
  - type: web
    runtime: docker
    name: xeroxgo-cloud
    plan: free
    region: singapore
    dockerfilePath: ./Dockerfile
    dockerContext: .
    healthCheckPath: /healthz
    autoDeployTrigger: checksPass
    envVars:
      - key: DATABASE_URL
        sync: false
      - key: XEROXGO_DEV_MODE
        value: "0"
      - key: XEROXGO_JOBS_DIR
        value: /tmp/xeroxgo/jobs
      - key: XEROXGO_PUBLIC_URL
        value: https://xeroxgo-7s6i.onrender.com
      - key: XEROXGO_PRICE_PER_SHEET_PAISE
        value: "200"
      - key: XEROXGO_DOWNLOAD_SECRET
        generateValue: true
      - key: XEROXGO_WEBHOOK_SECRET
        sync: false
      - key: XEROXGO_ADMIN_USER
        sync: false
      - key: XEROXGO_ADMIN_PASSWORD
        sync: false
      - key: XEROXGO_ALLOWED_ORIGINS
        sync: false

