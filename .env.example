# XeroxGo local development reference.
# The Go server does not automatically load this file; export these values
# in your shell or use scripts/run_local_demo.sh for the supported local demo.

PORT=8080
XEROXGO_DEV_MODE=1
XEROXGO_CLOUD_DB=./data/xeroxgo-cloud.db
XEROXGO_JOBS_DIR=./data/jobs
XEROXGO_PRICE_PER_SHEET_PAISE=200
XEROXGO_PUBLIC_URL=http://localhost:8080
XEROXGO_ADMIN_USER=admin
XEROXGO_ADMIN_PASSWORD=local-development-only-change-this
XEROXGO_DOWNLOAD_SECRET=local-development-only-change-this
XEROXGO_WEBHOOK_SECRET=local-development-only-change-this
XEROXGO_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# For a local Supabase/Postgres test only. Leave unset to use SQLite.
# DATABASE_URL=<set this in your local shell or hosting dashboard>
